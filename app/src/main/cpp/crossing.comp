#version 450

// The floor of a GPU develop: touch every input sample, write every output
// byte, and do as little as possible in between.
//
// The point of this shader is to be too cheap to matter, so that what the
// benchmark around it reports is the cost of *reaching* the GPU rather than the
// cost of any particular kernel. It still has to be real work on real data --
// a shader that read nothing or wrote nothing would let the driver drop the
// dispatch, and the result would be a very fast measurement of nothing.
//
// Samples arrive as packed pairs so that no 16-bit storage extension is
// needed: two CFA sites per uint, two RGBA pixels written per invocation.

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) readonly buffer Src { uint samples[]; };
layout(set = 0, binding = 1) writeonly buffer Dst { uint pixels[]; };

layout(push_constant) uniform Push { uint pairs; };

uint toPixel(uint sample10) {
    // 10-bit sensor code to an 8-bit grey, opaque. A shift rather than a
    // divide: the arithmetic is not what is being measured.
    uint b = sample10 >> 2;
    return b | (b << 8) | (b << 16) | 0xff000000u;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pairs) return;
    uint packed = samples[i];
    pixels[2u * i] = toPixel(packed & 0xffffu);
    pixels[2u * i + 1u] = toPixel(packed >> 16u);
}
