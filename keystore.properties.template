# Copy to keystore.properties and fill in. Never commit the real file or the .jks.
#
# Create a release key with:
#   keytool -genkeypair -v -keystore release.jks -alias multiframe \
#           -keyalg RSA -keysize 4096 -validity 10000
#
# Back the .jks and its passwords up somewhere safe. Losing them means you can
# never update the app under the same Play listing again.
storeFile=release.jks
storePassword=
keyAlias=multiframe
keyPassword=
